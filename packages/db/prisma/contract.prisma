// use prisma-8

// User of this sample_app.
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  userName String @unique @map("user_name")

  createdBlogs Blog[] /// The blogs created by the user

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([email])
  @@map("users")
}

/// Blog created by the user
model Blog {
  id      Int     @id @default(autoincrement())
  title   String
  tagLine String?
  body String

  published Boolean @default(false)

  author User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  publishedAt DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("blog")
}

/// Product listed in the store
model Product {
  id      Int     @id @default(autoincrement())
  name   String
  summary   String
  description   String

  price Int

  stockCount Int

  imageUrl   String

  @@map("product")
}
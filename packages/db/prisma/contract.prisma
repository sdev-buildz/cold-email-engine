// use prisma-8

// User of this sample_app.
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  userName String @unique @map("user_name")

  createdBlogs Blog[] /// The blogs created by the user

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([email])
  @@map("users")
}

/// Blog created by the user
model Blog {
  id      Int     @id @default(autoincrement())
  title   String
  tagLine String?
  body String

  published Boolean @default(false)

  author User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  publishedAt DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@map("blog")
}

/// Product listed in the store
model Product {
  id      Int     @id @default(autoincrement())
  name   String
  summary   String
  description   String

  price Int

  stockCount Int

  imageUrl   String

  @@map("product")
}

/// Status in the workflow sequence
native_enum SequenceStatus {
  NEW = "new"
  FIRST_SENT = "first_sent"
  FOLLOW_UP_1_SENT = "follow_up_1_sent"
  FOLLOW_UP_2_SENT = "follow_up_2_sent"
  FOLLOW_UP_3_SENT = "follow_up_3_sent"
  REPLIED = "replied"
  BOUNCED = "bounced"
  UNSUBSCRIBED = "unsubscribed"
  DEACTIVATED = "deactivated"
}
/// Classification of reply email based on its intent
native_enum ReplyIntent {

  /// The user wants more information, demo, or a pricing sheet
  INTERESTED = "interested"

  /// The user explicitly declines the offer but is polite.
  NOT_INTERESTED = "not_interested"

  /// The user wants to be removed from the list.
  UNSUBSCRIBE = "unsubscribe"

  /// Automated replies.
  OUT_OF_OFFICE = "out_of_office"

  /// The user directly proposes a time or asks for a booking link.
  MEETING_SCHEDULED = "meeting_scheduled"

  /// The contact says they aren't the right decision-maker but sometimes provides the correct contact.
  REFERRAL = "referral"
  
  /// Coudn't classify as any of the obove classes.
  OTHERS = "others"
}


/// Prospect's contact details
model Prospect {
  id        Int   @id @default(autoincrement())
  name      String
  email     String
  
  company   String
  role      String
  
  timezone  String

  /// Current status in the workflow sequence
  status    pg.enum(SequenceStatus) @default("new")

  /// Number of days to wait between emails.
  waitDays  SmallInt @default(3)

  /// Set to true, if no more email will be sent
  isDeactivated Boolean @default(false)

  lastSentAt DateTime @default("2026-10-25T00:00:00Z")

  /// Relation field: A user can have many sent emails
  sentEmails    EmailRecord[] 

  /// The next email to send after the current wait time.
  nextEmail     EmailRecord? @relation(fields: [nextEmailId], references: [id], onDelete: Restrict)
  nextEmailId   Int? 

  /// The reply sent by the prospect
  replyEmail     EmailRecord? @relation(fields: [replyEmailId], references: [id], onDelete: Restrict)
  replyEmailId   Int? 

  /// Classification of reply email based on its intent
  replyIntent pg.enum(ReplyIntent)?
}

native_enum EmailStatus {
  SENT = "sent"
  FAILED = "failed"
  PENDING = "pending"
}

model EmailRecord {
  id        Int   @id @default(autoincrement())
  subject   String
  body      String   // Use String for text. For HTML content, this works perfectly.
  status    pg.enum(EmailStatus) @default("pending")
  sentAt    DateTime @default(now())
  
  bounced   Boolean  @default(false)

  /// Foreign key linking to the User
  prospectId    Int
  prospect      Prospect   @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId]) // Index for fast lookups when fetching a user's email history
}

/// Email Templates where reciever specific details are marked by
///   placeholders in the form of XML tags. 
///   For example <name>, and <company> in the body will be replaced 
///   by the reciever's actual name and company respectively.
model EmailTemplate {
  id        Int   @id @default(autoincrement())
  subject   String
  body      String   // Use String for text. For HTML content, this works perfectly.

  sequence_state pg.enum(SequenceStatus)
}

model WorkflowStatus {
  id        Int   @id @default(autoincrement())
  
  /// Used to point to the current time during fast-forward
  currentTime DateTime @default("2026-10-26T00:00:00Z")

  /// The number of days to wait between consecutive emails
  waitIntervalDays Int @default(3)

  @@map("workflow-status")
}

///  The rates for different responses
///   The sum total of all these rates should be lesser than or equal to 100%.
///   If it is lesser, the remaining percentage can be 
///     considered as 'couldn't be classified by model', etc...
///
///  Contains only one row.
model ConversionMetrics {
  id              Int   @id @default(autoincrement())
  bounceRate      Int  @default(5)
  ignoreRate      Int @default(20)
  unsubscribeRate Int @default(40)
  notInterested   Int @default(15)
  oooRate         Int @default(5)
  referralRate    Int @default(2)
  interested      Int @default(5)
  meetingRate     Int @default(5)
}